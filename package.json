{
  "name": "aitran",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "description": "Free, privacy-first bilingual webpage translator browser extension.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "@types/node": "26.6.1",
    "happy-dom": "^18.0.1",
    "typescript": "7.0.2",
    "vitest": "4.0.18",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "pdfjs-dist": "5.4.296"
  }
}
